# ============================================================
# ACTUWISE — Fichier de configuration d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- OpenAI API (Module 6 — Assistant IA) ---
# Clé API OpenAI pour le LLM du RAG
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Modèle LLM utilisé pour le RAG ---
# Options : gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# --- Embeddings ---
# Modèle d'embeddings pour FAISS (OpenAI ou HuggingFace)
EMBEDDING_MODEL=text-embedding-3-small

# --- Chemins des données ---
# Répertoire contenant les CSV outputs des notebooks
DATA_DIR=./data

# Répertoire contenant les modèles pkl et pt
MODELS_DIR=./models

# Répertoire contenant les figures PNG exportées des notebooks
FIGURES_DIR=./figures

# Répertoire contenant les documents RAG (PDF circulaires CGA + IFRS 17)
DOCUMENTS_RAG_DIR=./documents_rag

# Répertoire de sauvegarde de l'index FAISS
FAISS_INDEX_DIR=./faiss_index

# --- Configuration FastAPI ---
# Environnement : development ou production
APP_ENV=development

# Autoriser les requêtes CORS depuis le frontend React (port 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port du backend FastAPI
PORT=8000

# --- Sécurité (optionnel en dev) ---
SECRET_KEY=actuwise_secret_key_change_in_production_2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- RAG Configuration ---
# Nombre de chunks récupérés par requête RAG
RAG_TOP_K=5

# Taille des chunks de texte pour l'indexation
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
